{
  "name": "@jtel/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "trim-far": "tsx src/trim-far-occurrences.ts",
    "studio": "drizzle-kit studio",
    "test": "TZ=UTC vitest run",
    "test:integration": "TZ=UTC vitest run --config vitest.integration.config.ts",
    "corregir-deadlines": "tsx src/corregir-deadlines.ts",
    "vincular-identidades": "tsx src/vincular-identidades.ts",
    "verificar-resumen": "tsx src/verificar-resumen-telemetria.ts",
    "verificar-conteos": "tsx src/verificar-conteos.ts",
    "medir-cadencia": "tsx src/medir-cadencia.ts",
    "verificar-solo-lectura": "tsx src/verificar-solo-lectura.ts"
  },
  "dependencies": {
    "@jtel/domain": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
