# === Contrato de variables de J-Telemetry ===
#
# Este archivo es la LISTA AUTORIZADA de nombres. No lleva valores: los valores
# viven en Vercel, y el `.env` local se genera desde ahí con `pnpm env:pull`.
#
#   pnpm env:pull    trae los valores de Vercel al .env local
#   pnpm env:check   revisa que el .env tenga lo que este contrato exige
#
# Si agregas una variable al código, agrégala aquí en el mismo commit.
# `pnpm env:check` compara ambos archivos y avisa cuando se separan — que es
# exactamente como se perdió una hora el 2026-07-30.

# --- Base de datos (Neon) ------------------------------------------------
# La inyecta la integración de Neon en Vercel → Storage. No se pega a mano.
DATABASE_URL=
# Respaldos que también inyecta la integración; apps/web/src/lib/db.ts cae a
# ellos en ese orden si falta DATABASE_URL.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Rol jtel_readonly. Es la red de seguridad de toda lectura contra producción:
# las verificaciones de antes y después de una migración corren con ésta.
# Su password DEBE ser distinto al del dueño — si es el mismo, quien tenga esta
# URL tiene también la del dueño con solo cambiar el usuario.
# Compruébala con: pnpm --filter @jtel/db verificar-solo-lectura
DATABASE_URL_READONLY=

# Rama de prueba de Neon, para los tests de integración.
DATABASE_URL_TEST=

# Destino del seed. OBLIGATORIA para `pnpm db:seed`: el seed hace TRUNCATE de
# TODAS las tablas, así que exige una base distinta de DATABASE_URL y se niega
# a correr contra producción.
SEED_DATABASE_URL=

# Memoria histórica de jrz-drone-os — solo para la migración, no para la app.
JRZ_OLD_MEMORY_DATABASE_URL=

# --- GPS Umbrella --------------------------------------------------------
UMBRELLA_GPS_URL=
UMBRELLA_GPS_BASE_URL=
UMBRELLA_GPS_USERID=
UMBRELLA_GPS_PASSWORD=

# OJO — apps/worker/src/run.ts lee ESTOS otros dos nombres, no los de arriba.
# Mientras esa divergencia siga, el worker necesita las dos parejas o se
# autentica con undefined. Ver docs/Procedimiento-Credenciales.md.
UMBRELLA_USER_ID=
UMBRELLA_PASSWORD=

# --- Secretos de la aplicación -------------------------------------------
CRON_SECRET=
JTEL_SECRET_KEY=

# --- Canal de alertas (correo por Resend) --------------------------------
# Las tres van juntas: sin una sola, /api/cron/alertas y /api/cron/alertas-resumen
# contestan 503 diciendo cuál falta, y Vercel marca la corrida como fallida. No
# se degrada a "no avisar en silencio" a propósito — el silencio es justo el
# fallo que esta plomería existe para romper.
#
# Clave de la integración de Resend en Vercel → Integrations.
RESEND_API_KEY=
# Remitente verificado, con nombre para que se lea en la bandeja:
#   J-Telemetry <alertas@j-tel.io>
ALERTAS_REMITENTE=
# A quién le llega. Varios, separados por coma. Es J-Staff, no clientes.
ALERTAS_DESTINATARIOS=

# --- Identidad (Clerk) ---------------------------------------------------
# Vuelven al contrato con el primer import de @clerk/nextjs. Se fueron en el
# commit de credenciales porque nada las referenciaba y el árbitro exige que
# toda variable declarada esté en uso — la regla hizo su trabajo.
#
# Las dos van juntas: la publicable monta el proveedor, la secreta deja que
# auth() lea la sesión en el servidor. Van como opcionales y no como requeridas
# porque la app está construida para funcionar sin ellas: sin llaves no se monta
# el proveedor, no corre el middleware de Clerk y la identidad cae al bypass de
# desarrollo — exactamente el comportamiento anterior. Eso es lo que permite que
# esto entre a main antes de aprovisionarlas en Vercel.
#
# Cuando /carrier quede cerrado (Paso 2), las dos pasan a REQUERIDAS en
# scripts/verificar-env.mjs. Es una línea, y ahí sí es obligatorio.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Opcionales ----------------------------------------------------------
# Si SALUD_TOKEN está definida, /api/salud la exige; si no, la ruta es abierta.
SALUD_TOKEN=
# Usuario que asume el entorno de desarrollo cuando no hay sesión de Clerk.
JTEL_DEV_USER=
# Secreto que habilita el encabezado x-jtel-user EN PRODUCCIÓN. Sin esta
# variable, el encabezado se ignora en producción y solo funciona en local —
# que es como debe ser: elegir identidad desde el navegador no puede quedar
# abierto a quien llegue a la URL. Con ella, seguimos pudiendo cambiar de
# usuario en un preview mandando también x-jtel-dev-token.
JTEL_DEV_TOKEN=

# --- No van aquí ---------------------------------------------------------
# DB_URL, DB_URL_RO y DB_URL_TEST son la convención de los scripts desechables:
# se pasan en la misma línea del comando, nunca se guardan.
#   DB_URL="$(grep -E '^DATABASE_URL_READONLY=' .env | cut -d= -f2-)" node x.mjs
