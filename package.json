{
  "name": "j-tel",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test && pnpm env:test && pnpm fuentes:test && pnpm cobro:test && pnpm zona:test",
    "env:pull": "pnpm dlx vercel@latest env pull .env",
    "env:check": "node scripts/verificar-env.mjs",
    "diff:check": "node scripts/verificar-diff-completo.mjs",
    "env:test": "node --test scripts/verificar-env.test.mjs",
    "fuentes:check": "node scripts/verificar-fuentes-locales.mjs",
    "fuentes:test": "node --test scripts/verificar-fuentes-locales.test.mjs",
    "db:generate": "pnpm --filter @jtel/db generate",
    "db:migrate": "pnpm --filter @jtel/db migrate",
    "db:seed": "pnpm --filter @jtel/db seed",
    "db:studio": "pnpm --filter @jtel/db studio",
    "cobro:check": "node scripts/verificar-sin-cobro.mjs",
    "cobro:test": "node --test scripts/verificar-sin-cobro.test.mjs",
    "zona:check": "node scripts/verificar-zona-de-pruebas.mjs",
    "zona:test": "node --test scripts/verificar-zona-de-pruebas.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  }
}
